flowchart TD
    subgraph Environment ["Digital Twin (Port 9090)"]
        BuildSim["BuildSim<br/>(in-memory A-House state, 3D view)"]
        Sim["Physical Simulator (Go)<br/>(room physics, re-seeding)"]
    end

    subgraph EdgeLayer ["Edge Microservices (Go)"]
        Sensors["Sensor Gateway<br/>(temperature, CO2, occupancy at 2 Hz)"]
        Actuators["Actuator Controller<br/>(safety guardrail clamp)"]
    end

    subgraph Messaging ["Telemetry Pipeline"]
        Broker["Mosquitto MQTT Broker"]
        Pipeline["Telemetry Ingestor (Go)<br/>validation, dedup, power model"]
        Store[("SQLite WAL<br/>+ JSONL export")]
    end

    subgraph Intelligence ["Decision Engine (Python)"]
        Controller["Smart Controller<br/>(Model 01 + Model 02 + MPC, Safe Fallback)"]
    end

    subgraph Visualization ["User Interface"]
        Dashboard["Web Dashboard<br/>(live kWh savings, MPC plan)"]
    end

    Sim <-->|"REST"| BuildSim
    BuildSim -->|"1. Poll sensors (REST)"| Sensors
    Sensors -->|"2. Publish telemetry (MQTT)"| Broker
    Broker -->|"3. Subscribe"| Pipeline
    Pipeline --> Store
    Store -->|"4. Recent window (REST)"| Controller
    Controller -->|"5. Command (REST)"| Actuators
    Actuators -->|"6. Apply setpoint/damper (REST)"| BuildSim
    Controller -->|"Live state (WebSocket)"| Dashboard
    BuildSim -.->|"3D viewer"| Dashboard
