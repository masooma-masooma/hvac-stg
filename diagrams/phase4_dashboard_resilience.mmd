flowchart TD
    subgraph Users ["User & Operator Interface"]
        Browser["Operator Browser"]
    end

    subgraph DashboardService ["Web Dashboard Container (:3000)"]
        UI["Static Web UI"]
        Charts["Live Charts (Chart.js): temperature vs baseline, MPC plan, forecast vs actual occupancy"]
        KPIs["Energy savings & status badges (transport, MPC / Safe Fallback)"]
        Controls["Occupancy injection & guardrail test"]
    end

    subgraph AutonomousCore ["Autonomous Edge Microservices"]
        MPC["Smart MPC Controller (:8082)"]
        AC["Actuator Controller (:8080)"]
        Ingestor["Telemetry Ingestor & SQLite (:8081)"]
        BS["BuildSim 3D Digital Twin (:9090)"]
        Mosq["Mosquitto MQTT Broker (:1883)"]
        Sim["Physical Simulator (self-healing)"]
    end

    subgraph FaultInjection ["Resilience Suite (scripts/test_resilience.py)"]
        T1["Test 1: MQTT broker restart"]
        T2["Test 2: BuildSim restart / state wipe"]
        T3["Test 3: Safety guardrail clamping"]
        T4["Test 4: Simulator stopped -> Safe Fallback"]
        T5["Test 5: Controller process exit -> restart"]
    end

    Browser <-->|"HTTP :3000"| UI
    UI --- Charts
    UI --- KPIs
    UI --- Controls

    UI <-->|"WebSocket /ws/telemetry (REST fallback)"| MPC
    Controls -->|"PUT /api/occupancy"| BS
    Controls -->|"POST /commands"| AC

    T1 -.-> Mosq
    T2 -.-> BS
    T3 -.-> AC
    T4 -.-> Sim
    T5 -.-> MPC
